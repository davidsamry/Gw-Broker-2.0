DATABASE_URL="postgresql://user:password@localhost:5432/gw_broker"
JWT_SECRET="troque-por-uma-string-aleatoria-longa-e-segura"
JWT_REFRESH_SECRET="outra-string-aleatoria-diferente-da-de-cima"
PORT=3001
FRONTEND_URL="http://localhost:3000"
DEMO_INITIAL_BALANCE=10000

# Desliga os background workers (engine OTC, resolucao de operacoes, auto-saque
# fake). Esses workers ESCREVEM no banco. Se voce rodar a API local apontando
# pro banco de PRODUCAO, deixe =true para NAO virar uma segunda engine de preco
# (causa "vela verde mas marcou loss" pros usuarios reais). Em producao
# (NODE_ENV=production) a flag e' IGNORADA — os workers sempre rodam.
DISABLE_BACKGROUND_WORKERS=true

# URL publica da API (usada para montar as URLs de webhook dos gateways)
API_PUBLIC_URL="https://api.vx-global.com"

# ─────────────────────────────────────────────────────────────────────────
# GATEWAY 1 — BSPay (em producao). NAO remover.
# ─────────────────────────────────────────────────────────────────────────
BSPAY_CLIENT_ID=""
BSPAY_CLIENT_SECRET=""
# BSPAY_BASE_URL="https://api.bspay.co"        # opcional
BSPAY_WEBHOOK_SECRET=""                        # string aleatoria usada na URL do webhook
BSPAY_WEBHOOK_HMAC_SECRET=""                   # opcional (HMAC no Dashboard BSPay)

# ─────────────────────────────────────────────────────────────────────────
# GATEWAY 2 — Versell (Cash In / Pix). Docs: https://docs.versell.com.br
#
# O gateway ATIVO e escolhido no painel admin (/admin/configuracoes),
# NAO por env var. Estas variaveis apenas guardam as credenciais.
# ─────────────────────────────────────────────────────────────────────────
VERSELL_CLIENT_ID=""
VERSELL_CLIENT_SECRET=""
VERSELL_PIX_KEY=""                             # chave Pix que recebe as cobrancas
# VERSELL_BASE_URL="https://api.pix.basspago.com.br"   # opcional

# mTLS — use .crt + .key OU o .pfx (nunca versionar estes arquivos!)
VERSELL_CERT_PATH="/etc/versell/client.crt"
VERSELL_KEY_PATH="/etc/versell/client.key"
# VERSELL_PFX_PATH="/etc/versell/client.pfx"
# VERSELL_PFX_PASSWORD=""
# VERSELL_CA_PATH="/etc/versell/ca.crt"        # so se a Versell exigir CA custom

# Webhook Versell: o path-secret compoe a URL registrada na Versell e o
# header secret valida o X-Webhook-Secret de cada notificacao.
VERSELL_WEBHOOK_SECRET=""                      # string aleatoria longa (path)
VERSELL_WEBHOOK_HEADER_SECRET=""               # opcional; se vazio, usa o de cima

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum AccountType {
  DEMO
  REAL
}

enum Direction {
  CALL
  PUT
}

enum OperationStatus {
  OPEN
  WON
  LOST
  CANCELLED
}

enum TransactionType {
  DEMO_CREDIT
  DEPOSIT
  WITHDRAWAL
  TRADE_WIN
  TRADE_LOSS
  BONUS
  // Manual balance changes performed by an admin. Sign of `amount` indicates
  // direction (+ credit / - debit). The `description` field carries the
  // admin id + reason for audit.
  ADJUSTMENT
}

enum KycStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
}

enum UserRole {
  USER
  ADMIN
}

enum DepositStatus {
  PENDING      // Created — awaiting payment / admin confirmation
  PAID         // Confirmed and credited
  FAILED       // Gateway error
  CANCELLED    // User cancelled
}

enum DepositMethod {
  PIX
  CREDIT_CARD
  BANK_TRANSFER
  CRYPTO
}

enum WithdrawalStatus {
  PENDING     // Awaiting admin / processor review
  APPROVED    // Approved, sent to payment provider
  COMPLETED   // Provider confirmed funds sent
  CANCELLED   // User cancelled OR admin rejected — funds refunded
  FAILED      // Provider error — funds refunded
}

enum WithdrawalMethod {
  PIX
  USDT_TRC20
  BANK_TRANSFER
}

enum TicketStatus {
  OPEN          // Aberto — awaiting first admin response
  IN_PROGRESS   // Em andamento — admin already replied, ball is in user's court / WIP
  RESOLVED      // Resolvido — admin closed after answering
  CLOSED        // Fechado — closed without resolution (duplicate / spam / etc.)
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

enum AssetCategory {
  OPEN_MARKET   // Forex pairs that follow real market hours
  OTC           // OTC pairs that trade 24/7 with synthetic pricing
  CRYPTO        // Crypto spot pairs
}

// ── OTC v2 enums (new pricing engine, separate from legacy AssetCategory)
enum OtcCategory {
  FOREX
  CRYPTO
  COMMODITIES
  INDICES
}

enum OtcRegime {
  LATERAL
  TREND_UP_WEAK
  TREND_UP_STRONG
  TREND_DOWN_WEAK
  TREND_DOWN_STRONG
  HIGH_VOL
  LOW_VOL
  COMPRESSION
  EXPANSION
}

enum OtcEventDirection {
  UP
  DOWN
  NEUTRAL
}

enum OtcEventStrength {
  LOW
  MEDIUM
  HIGH
}

enum OtcEventStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  password     String
  name         String
  // Optional profile fields populated by the Minha Conta form.
  nickname     String?
  lastName     String?
  birthDate    DateTime?  @db.Date
  cpf          String?
  phone        String?
  country      String?
  address      String?
  kycStatus    KycStatus  @default(PENDING)
  role         UserRole   @default(USER)
  // ── Two-factor authentication (TOTP / Google Authenticator) ──
  // twoFactorSecret is base32 — only present once enrolled.
  // twoFactorEnabled flips true only after the user confirms a code,
  // proving they scanned the QR. Login flow checks the flag, not the secret.
  twoFactorSecret  String?
  twoFactorEnabled Boolean   @default(false)
  // Admin can soft-block a user — login is denied while blocked. Operations
  // already executed are left untouched. blockedReason explains why.
  blocked          Boolean   @default(false)
  blockedAt        DateTime?
  blockedReason    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  accounts        Account[]
  kycSubmission   KycSubmission?
  tickets         Ticket[]
  ticketMessages  TicketMessage[]

  @@map("users")
}

model Account {
  id        String      @id @default(cuid())
  userId    String
  type      AccountType
  balance   Decimal     @default(0) @db.Decimal(18, 2)
  currency  String      @default("BRL")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  operations   Operation[]
  transactions Transaction[]
  withdrawals  Withdrawal[]
  deposits     Deposit[]

  @@unique([userId, type])
  @@map("accounts")
}

model Operation {
  id           String          @id @default(cuid())
  accountId    String
  assetId      String
  assetSymbol  String
  marketSymbol String?         // Binance ticker (e.g. "BTCUSDT") — used by worker to fetch real exit price
  direction    Direction
  amount       Decimal         @db.Decimal(18, 2)
  payout       Int
  entryPrice   Decimal         @db.Decimal(18, 5)
  exitPrice    Decimal?        @db.Decimal(18, 5)
  profit       Decimal?        @db.Decimal(18, 2)
  status       OperationStatus @default(OPEN)
  expiresAt    DateTime
  openedAt     DateTime        @default(now())
  closedAt     DateTime?

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, status])
  @@index([expiresAt, status])
  @@map("operations")
}

model Transaction {
  id          String          @id @default(cuid())
  accountId   String
  type        TransactionType
  amount      Decimal         @db.Decimal(18, 2)
  description String?
  createdAt   DateTime        @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("transactions")
}

model KycSubmission {
  id                String     @id @default(cuid())
  userId            String     @unique  // one active submission per user
  documentFrontUrl  String
  documentBackUrl   String
  selfieUrl         String
  status            KycStatus  @default(SUBMITTED)  // SUBMITTED → APPROVED|REJECTED
  reason            String?    // populated when status = REJECTED
  submittedAt       DateTime   @default(now())
  reviewedAt        DateTime?
  reviewedBy        String?    // admin user id

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, submittedAt])
  @@map("kyc_submissions")
}

model Deposit {
  id          String         @id @default(cuid())
  accountId   String
  amount      Decimal        @db.Decimal(18, 2)
  bonus       Decimal?       @db.Decimal(18, 2)  // promotional bonus credited on payment
  method      DepositMethod  @default(PIX)
  externalId  String?        // gateway transaction reference
  status      DepositStatus  @default(PENDING)
  isFake      Boolean        @default(false)     // admin marker: test/manual deposit
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  paidAt      DateTime?

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([accountId, status])
  @@map("deposits")
}

model Withdrawal {
  id          String           @id @default(cuid())
  accountId   String
  amount      Decimal          @db.Decimal(18, 2)
  method      WithdrawalMethod
  destination String           // PIX key, USDT wallet, bank account info
  status      WithdrawalStatus @default(PENDING)
  notes       String?          // Admin notes / failure reason
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  processedAt DateTime?        // Set when status moves out of PENDING

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, status])
  @@index([status, createdAt])
  @@map("withdrawals")
}

// Tradable instrument the admin can enable / disable and price (payout %).
// Source of truth lives here so admins can tune odds per asset without a
// code change. The trading frontend still uses a static catalog today —
// migration to consume this table is a follow-up.
model Asset {
  id            String        @id @default(cuid())
  symbol        String        @unique  // "EURUSD"
  name          String                 // "Euro / Dólar"
  category      AssetCategory
  payout        Int           @default(85)  // % — 1..100
  enabled       Boolean       @default(true)
  // Flag codes (flagcdn.com) for the leading/trailing currency. CRYPTO rows
  // may pass "crypto:btc" etc. to render a coin icon instead of a flag.
  code1         String?
  code2         String?
  // Optional Binance market symbol for live pricing on crypto / forex.
  // When null AND seedPrice is set, the asset is OTC-priced server-side.
  marketSymbol  String?
  // Manual sort key — admin can drag-reorder later; for now we seed in the
  // order we want them to display.
  displayOrder  Int           @default(0)

  // ── OTC pricing controls (used only when marketSymbol IS NULL) ─────────
  // seedPrice    = baseline the random walk mean-reverts toward. Without
  //                this set the OTC worker skips the asset entirely.
  // volatility   = tick size as a fraction of seedPrice (0.0005 ≈ 5 bp).
  // tickIntervalMs = how often the worker advances this asset. Default 1s;
  //                  bumping it (e.g. to 250ms) makes "fast" OTC assets.
  seedPrice       Decimal?      @db.Decimal(18, 5)
  volatility      Float         @default(0.0005)
  tickIntervalMs  Int           @default(1000)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([category, displayOrder])
  @@map("assets")
}

// Support ticket opened by a user. The first message body lives in TicketMessage
// (so all replies share one model); the ticket row itself only carries metadata
// (subject, status, priority). Admin actions: reply, change status, change priority.
model Ticket {
  id         String         @id @default(cuid())
  userId     String
  subject    String
  status     TicketStatus   @default(OPEN)
  priority   TicketPriority @default(MEDIUM)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  // Last activity timestamp — used for sorting in admin view. Bumped on any
  // new message OR status/priority change.
  lastActivityAt DateTime   @default(now())

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  TicketMessage[]

  @@index([status, lastActivityAt])
  @@index([userId, createdAt])
  @@map("tickets")
}

// One message in a ticket thread. authorId is the user OR the admin id.
// isAdmin distinguishes the two without an extra join (admins are still
// rows in `users`, just with role = ADMIN). The first message of a ticket
// is created together with the ticket itself (atomic in the create handler).
model TicketMessage {
  id            String   @id @default(cuid())
  ticketId      String
  authorId      String
  isAdmin       Boolean  @default(false)
  body          String
  // Optional image attachment, stored as a data URL (data:image/...;base64,...)
  // Same approach KYC uses — keeps us free of object storage infra for now.
  attachmentUrl String?
  createdAt     DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

// ─── OTC v2 — server-side pricing engine ──────────────────────────────────
// Brand new tables (otc_* prefix) kept fully isolated from the legacy
// `assets` + `asset_price_ticks` pair, which stays put until Etapa 8
// cleanup. Binance assets are untouched — they live in mockData.ts on the
// frontend and use Binance's own kline WebSocket. The new engine only
// drives the 5 OTC assets seeded in migration 20260524_otc_v2_seed.

model OtcAsset {
  id              String       @id              // 'eur-usd-otc'
  symbol          String       @unique          // 'EUR/USD'
  name            String                        // 'EUR/USD OTC'
  category        OtcCategory
  enabled         Boolean      @default(true)
  paused          Boolean      @default(false)  // admin can freeze the engine for this asset
  payout          Int          @default(85)
  // Baseline price the random walk mean-reverts toward.
  seedPrice       Decimal      @db.Decimal(18, 5)
  // Tick size as a fraction of seedPrice (e.g., 0.0005 = 5 basis points).
  volatilityBase  Float        @default(0.0005)
  // Multiplies the engine's tick rate. 1 = base (10Hz); 2 = "fast" asset.
  speedMultiplier Float        @default(1.0)
  displayOrder    Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  state           OtcMarketState?
  liquidity       OtcLiquidityState?
  snapshot        OtcEngineSnapshot?
  ticks           OtcTick[]
  candles         OtcCandle[]
  events          OtcScheduledEvent[]

  @@index([category, displayOrder])
  @@map("otc_assets")
}

// Append-only tick stream. Engine writes batched (~1s) to keep DB
// pressure low; retention ~1h via a periodic prune job.
model OtcTick {
  id          BigInt   @id @default(autoincrement())
  assetId     String
  price       Decimal  @db.Decimal(18, 5)
  recordedAt  DateTime @default(now()) @db.Timestamptz(3)

  asset       OtcAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, recordedAt(sort: Desc)])
  // Fase 7: covers the prune query `WHERE recordedAt < NOW() - INTERVAL '1h'`
  // which can't use the leading-assetId index. Added via migration
  // 20260525014500_otc_ticks_recordedat_index.
  @@index([recordedAt], name: "otc_ticks_recordedAt_idx")
  @@map("otc_ticks")
}

// Aggregated OHLC bars per (asset, timeframe). One row per slot.
// `finalizedAt` non-null = candle closed (timeframe rolled). Worker reads
// the candle covering `op.expiresAt` for resolution; never recomputes.
model OtcCandle {
  id           BigInt   @id @default(autoincrement())
  assetId      String
  timeframe    Int                                       // seconds: 5, 15, 30, 60, 300
  openTime     DateTime @db.Timestamptz(3)
  openPrice    Decimal  @db.Decimal(18, 5)
  highPrice    Decimal  @db.Decimal(18, 5)
  lowPrice     Decimal  @db.Decimal(18, 5)
  closePrice   Decimal  @db.Decimal(18, 5)
  tickCount    Int
  finalizedAt  DateTime? @db.Timestamptz(3)

  asset        OtcAsset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, timeframe, openTime])
  @@index([assetId, timeframe, openTime(sort: Desc)])
  // Fase 7: covers the prune query `WHERE timeframe = X AND openTime < Y`
  // which can't use the leading-assetId index efficiently.
  @@index([timeframe, openTime], name: "otc_candles_timeframe_openTime_idx")
  @@map("otc_candles")
}

// Per-asset market regime FSM state. One row per asset (assetId is PK).
model OtcMarketState {
  assetId          String     @id
  currentRegime    OtcRegime  @default(LATERAL)
  regimeStartedAt  DateTime   @default(now())
  regimeDurationS  Int        @default(60)
  // Effective drift applied per tick (signed). Modulated by regime + events.
  currentDrift     Float      @default(0)
  // Effective volatility per tick. Modulated by regime.
  currentVol       Float      @default(0.0005)
  // Admin override: long-running bias added to drift. -1..+1.
  trendBias        Float      @default(0)
  updatedAt        DateTime   @updatedAt

  asset            OtcAsset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  @@map("otc_market_state")
}

// Per-asset liquidity / order-book simulation. Slow-moving (~10s update
// cadence) compared to ticks.
model OtcLiquidityState {
  assetId       String   @id
  spread        Float    @default(0.0001)
  buyPressure   Float    @default(0.5)   // 0..1
  sellPressure  Float    @default(0.5)
  volume        Float    @default(1.0)   // 0.5..2.0 multiplier
  depth         Float    @default(1.0)
  speed         Float    @default(1.0)
  updatedAt     DateTime @updatedAt

  asset         OtcAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  @@map("otc_liquidity_state")
}

// Admin-scheduled events that bias the engine for a window.
model OtcScheduledEvent {
  id           String              @id @default(cuid())
  assetId      String
  startAt      DateTime
  durationSec  Int
  direction    OtcEventDirection
  strength     OtcEventStrength
  volatility   Float?                              // optional override during the event
  note         String?
  status       OtcEventStatus      @default(SCHEDULED)
  createdBy    String                              // admin userId
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  asset        OtcAsset            @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([status, startAt])
  @@index([assetId, status])
  @@map("otc_scheduled_events")
}

// Engine self-diagnostic log (errors, regime transitions, etc.).
model OtcEngineLog {
  id         BigInt   @id @default(autoincrement())
  level      String                                // 'INFO' | 'WARN' | 'ERROR'
  message    String
  context    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@map("otc_engine_logs")
}

// Deterministic engine snapshot (Fase 3). One row per asset, UPSERTed
// every 5s + on shutdown. Primary boot recovery source — captures the
// EMA-smoothed price + full FSM/liquidity state atomically so a
// restart resumes without the multi-source reconstruction that
// candle/tick fallbacks have to do.
model OtcEngineSnapshot {
  assetId          String   @id
  snapshotVersion  Int      @default(1)
  currentPrice     Decimal  @db.Decimal(18, 5)
  smoothedPrice    Decimal  @db.Decimal(18, 5)
  regime           OtcRegime
  regimeStartedAt  DateTime @db.Timestamptz(3)
  regimeDurationMs Int
  spread           Float    @default(0.0001)
  buyPressure      Float    @default(0.5)
  sellPressure     Float    @default(0.5)
  volume           Float    @default(1.0)
  depth            Float    @default(1.0)
  speed            Float    @default(1.0)
  trendBias        Float    @default(0)
  lastTickTime     DateTime? @db.Timestamptz(3)
  lastCandleTime   DateTime? @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @db.Timestamptz(3)

  asset            OtcAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([updatedAt(sort: Desc)])
  @@map("otc_engine_snapshot")
}

// Audit trail of admin actions on OTC engine.
model OtcAdminLog {
  id           BigInt   @id @default(autoincrement())
  adminId      String
  action       String                              // 'UPDATE_VOLATILITY', 'PAUSE_ASSET', ...
  assetId      String?
  beforeState  Json?
  afterState   Json?
  createdAt    DateTime @default(now())

  @@index([assetId, createdAt(sort: Desc)])
  @@index([adminId, createdAt(sort: Desc)])
  @@map("otc_admin_logs")
}

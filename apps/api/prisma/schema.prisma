generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum AccountType {
  DEMO
  REAL
}

enum Direction {
  CALL
  PUT
}

enum OperationStatus {
  OPEN
  WON
  LOST
  CANCELLED
}

enum TransactionType {
  DEMO_CREDIT
  DEPOSIT
  WITHDRAWAL
  TRADE_WIN
  TRADE_LOSS
  BONUS
  // Manual balance changes performed by an admin. Sign of `amount` indicates
  // direction (+ credit / - debit). The `description` field carries the
  // admin id + reason for audit.
  ADJUSTMENT
}

enum KycStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
}

enum UserRole {
  USER
  ADMIN
}

enum WithdrawalStatus {
  PENDING     // Awaiting admin / processor review
  APPROVED    // Approved, sent to payment provider
  COMPLETED   // Provider confirmed funds sent
  CANCELLED   // User cancelled OR admin rejected — funds refunded
  FAILED      // Provider error — funds refunded
}

enum WithdrawalMethod {
  PIX
  USDT_TRC20
  BANK_TRANSFER
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  password     String
  name         String
  // Optional profile fields populated by the Minha Conta form.
  nickname     String?
  lastName     String?
  birthDate    DateTime?  @db.Date
  cpf          String?
  phone        String?
  country      String?
  address      String?
  kycStatus    KycStatus  @default(PENDING)
  role         UserRole   @default(USER)
  // ── Two-factor authentication (TOTP / Google Authenticator) ──
  // twoFactorSecret is base32 — only present once enrolled.
  // twoFactorEnabled flips true only after the user confirms a code,
  // proving they scanned the QR. Login flow checks the flag, not the secret.
  twoFactorSecret  String?
  twoFactorEnabled Boolean   @default(false)
  // Admin can soft-block a user — login is denied while blocked. Operations
  // already executed are left untouched. blockedReason explains why.
  blocked          Boolean   @default(false)
  blockedAt        DateTime?
  blockedReason    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  accounts        Account[]
  kycSubmission   KycSubmission?

  @@map("users")
}

model Account {
  id        String      @id @default(cuid())
  userId    String
  type      AccountType
  balance   Decimal     @default(0) @db.Decimal(18, 2)
  currency  String      @default("BRL")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  operations   Operation[]
  transactions Transaction[]
  withdrawals  Withdrawal[]

  @@unique([userId, type])
  @@map("accounts")
}

model Operation {
  id           String          @id @default(cuid())
  accountId    String
  assetId      String
  assetSymbol  String
  marketSymbol String?         // Binance ticker (e.g. "BTCUSDT") — used by worker to fetch real exit price
  direction    Direction
  amount       Decimal         @db.Decimal(18, 2)
  payout       Int
  entryPrice   Decimal         @db.Decimal(18, 5)
  exitPrice    Decimal?        @db.Decimal(18, 5)
  profit       Decimal?        @db.Decimal(18, 2)
  status       OperationStatus @default(OPEN)
  expiresAt    DateTime
  openedAt     DateTime        @default(now())
  closedAt     DateTime?

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, status])
  @@index([expiresAt, status])
  @@map("operations")
}

model Transaction {
  id          String          @id @default(cuid())
  accountId   String
  type        TransactionType
  amount      Decimal         @db.Decimal(18, 2)
  description String?
  createdAt   DateTime        @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("transactions")
}

model KycSubmission {
  id                String     @id @default(cuid())
  userId            String     @unique  // one active submission per user
  documentFrontUrl  String
  documentBackUrl   String
  selfieUrl         String
  status            KycStatus  @default(SUBMITTED)  // SUBMITTED → APPROVED|REJECTED
  reason            String?    // populated when status = REJECTED
  submittedAt       DateTime   @default(now())
  reviewedAt        DateTime?
  reviewedBy        String?    // admin user id

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, submittedAt])
  @@map("kyc_submissions")
}

model Withdrawal {
  id          String           @id @default(cuid())
  accountId   String
  amount      Decimal          @db.Decimal(18, 2)
  method      WithdrawalMethod
  destination String           // PIX key, USDT wallet, bank account info
  status      WithdrawalStatus @default(PENDING)
  notes       String?          // Admin notes / failure reason
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  processedAt DateTime?        // Set when status moves out of PENDING

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, status])
  @@index([status, createdAt])
  @@map("withdrawals")
}

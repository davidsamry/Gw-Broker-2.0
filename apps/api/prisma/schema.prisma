generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum AccountType {
  DEMO
  REAL
}

enum Direction {
  CALL
  PUT
}

enum OperationStatus {
  OPEN
  WON
  LOST
  CANCELLED
}

enum TransactionType {
  DEMO_CREDIT
  DEPOSIT
  WITHDRAWAL
  TRADE_WIN
  TRADE_LOSS
  BONUS
  // Manual balance changes performed by an admin. Sign of `amount` indicates
  // direction (+ credit / - debit). The `description` field carries the
  // admin id + reason for audit.
  ADJUSTMENT
  // Compra de acesso a um Copy Trader pago (amount negativo). A descricao
  // carrega "Compra de Copy Trader - <nome>".
  COPY_PURCHASE
  // Resultado (ganho/perda) de uma operacao de copy trading liquidada pelo
  // copyWorker. Sinal do amount indica direcao (+ ganho / - perda). A
  // descricao carrega "Copy Trade - <nome> (Ganho|Perda)".
  COPY_RESULT
}

enum KycStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
}

enum UserRole {
  USER
  ADMIN
}

enum DepositStatus {
  PENDING      // Created — awaiting payment / admin confirmation
  PAID         // Confirmed and credited
  FAILED       // Gateway error
  CANCELLED    // User cancelled
}

enum DepositMethod {
  PIX
  CREDIT_CARD
  BANK_TRANSFER
  CRYPTO
}

enum WithdrawalStatus {
  PENDING     // Awaiting admin / processor review
  APPROVED    // Approved, sent to payment provider
  COMPLETED   // Provider confirmed funds sent
  CANCELLED   // User cancelled OR admin rejected — funds refunded
  FAILED      // Provider error — funds refunded
}

enum WithdrawalMethod {
  PIX
  USDT_TRC20
  BANK_TRANSFER
}

enum TicketStatus {
  OPEN          // Aberto — awaiting first admin response
  IN_PROGRESS   // Em andamento — admin already replied, ball is in user's court / WIP
  RESOLVED      // Resolvido — admin closed after answering
  CLOSED        // Fechado — closed without resolution (duplicate / spam / etc.)
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

enum AssetCategory {
  OPEN_MARKET   // Forex pairs that follow real market hours
  OTC           // OTC pairs that trade 24/7 with synthetic pricing
  CRYPTO        // Crypto spot pairs
}

// ── OTC v2 enums (new pricing engine, separate from legacy AssetCategory)
enum OtcCategory {
  FOREX
  CRYPTO
  COMMODITIES
  INDICES
}

enum OtcRegime {
  LATERAL
  TREND_UP_WEAK
  TREND_UP_STRONG
  TREND_DOWN_WEAK
  TREND_DOWN_STRONG
  HIGH_VOL
  LOW_VOL
  COMPRESSION
  EXPANSION
}

enum OtcEventDirection {
  UP
  DOWN
  NEUTRAL
}

enum OtcEventStrength {
  LOW
  MEDIUM
  HIGH
}

enum OtcEventStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

// ── Bonus system (Fase B1) ────────────────────────────────────────────────
// Promotional codes admin defines once (Bonus); each redemption produces a
// BonusGrant that tracks per-user state including rollover progress.

enum BonusType {
  PERCENTAGE   // value = % of deposit amount (e.g., 200 = +200% bonus)
  FIXED        // value = flat R$ credit regardless of deposit size
}

enum BonusGrantStatus {
  PENDING      // grant created with a deposit, awaiting deposit to be PAID
  ACTIVE       // deposit confirmed, bonus credited, rollover in progress
  COMPLETED    // rollover requirement met — bonus is fully unlocked
  CANCELLED    // user gave up on bonus OR admin revoked
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  password     String
  name         String
  // Optional profile fields populated by the Minha Conta form.
  nickname     String?
  lastName     String?
  birthDate    DateTime?  @db.Date
  cpf          String?
  phone        String?
  country      String?
  address      String?
  // Endereço granular — coletado no perfil (Minha Conta). Usado pra enriquecer
  // os webhooks de tracking (advanced matching: city/state/zip). Opcionais.
  city         String?
  state        String?
  zip          String?
  kycStatus    KycStatus  @default(PENDING)
  role         UserRole   @default(USER)
  // ── Two-factor authentication (TOTP / Google Authenticator) ──
  // twoFactorSecret is base32 — only present once enrolled.
  // twoFactorEnabled flips true only after the user confirms a code,
  // proving they scanned the QR. Login flow checks the flag, not the secret.
  twoFactorSecret  String?
  twoFactorEnabled Boolean   @default(false)
  // Admin can soft-block a user — login is denied while blocked. Operations
  // already executed are left untouched. blockedReason explains why.
  blocked          Boolean   @default(false)
  blockedAt        DateTime?
  blockedReason    String?
  // ── Admin-side toggles ──────────────────────────────────────────────────
  // isFake          → user is a demo/test account; doesn't affect KPIs.
  //                   Also forces every operation to resolve WON (see
  //                   apps/api/src/operations/worker.ts).
  // copyTraderEnabled → user can subscribe to a copy trader (future feature).
  // liquidityMode   → "liquidez" toggle. When TRUE, 70% of this user's
  //                   operations are FORCED to LOST regardless of the
  //                   real price. See operations/worker.ts.
  // All default false — opt-in by admin via the edit drawer.
  isFake             Boolean   @default(false)
  copyTraderEnabled  Boolean   @default(false)
  liquidityMode      Boolean   @default(false)
  // ── Per-user payout overrides ───────────────────────────────────────────
  // When set (non-null), the trading engine uses this % instead of the
  // asset's default payout for that market. Null = use asset default.
  // Range 0-100, validated on input.
  payoutOverrideForex   Int?
  payoutOverrideOtc     Int?
  payoutOverrideCrypto  Int?
  // ── Per-user market permissions ─────────────────────────────────────────
  // Default true (legacy users keep full access). Admin can revoke a
  // specific market for a user (KYC mismatch, compliance, etc).
  canTradeForex    Boolean   @default(true)
  canTradeOtc      Boolean   @default(true)
  canTradeCrypto   Boolean   @default(true)
  // ── Auto-throttle (auto-ativação de liquidez) ──────────────────────────
  // Saldo REAL no momento do último depósito confirmado. Quando o saldo
  // ultrapassa baseline × (1 + autoLiquidityProfitPct/100), o worker
  // ativa liquidityMode=true e canTradeCrypto=false automaticamente.
  // Atualizado por deposits/service.ts em cada confirmação de PAID.
  // Default 0 = não dispara (saldo/0 evitado por guard no worker).
  bankrollBaseline Decimal   @default(0) @db.Decimal(18, 2)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  accounts            Account[]
  kycSubmission       KycSubmission?
  tickets             Ticket[]
  ticketMessages      TicketMessage[]
  passwordResetTokens PasswordResetToken[]
  botRefreshTokens    BotRefreshToken[]
  adminTrustedDevices AdminTrustedDevice[]
  // Meta Conversions API attribution data captured at register time.
  // 1-to-1 (one row per user) — see UserTracking model below.
  tracking            UserTracking?
  // Histórico de IPs de acesso (1 linha por IP distinto) — ver LoginHistory.
  loginHistory        LoginHistory[]

  @@map("users")
}

model Account {
  id        String      @id @default(cuid())
  userId    String
  type      AccountType
  balance   Decimal     @default(0) @db.Decimal(18, 2)
  // Admin-managed bonus balance + rollover state. Independent from the
  // BonusGrant table (that one tracks individual code redemptions); these
  // three fields let admin set "lump-sum" values directly via the user
  // edit drawer without needing to mint a synthetic Bonus row.
  bonusBalance     Decimal     @default(0) @db.Decimal(18, 2)
  rolloverRequired Decimal     @default(0) @db.Decimal(18, 2)
  rolloverProgress Decimal     @default(0) @db.Decimal(18, 2)
  currency  String      @default("BRL")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  operations   Operation[]
  transactions Transaction[]
  withdrawals  Withdrawal[]
  deposits     Deposit[]

  @@unique([userId, type])
  @@map("accounts")
}

model Operation {
  id           String          @id @default(cuid())
  accountId    String
  assetId      String
  assetSymbol  String
  marketSymbol String?         // Binance ticker (e.g. "BTCUSDT") — used by worker to fetch real exit price
  direction    Direction
  amount       Decimal         @db.Decimal(18, 2)
  payout       Int
  entryPrice   Decimal         @db.Decimal(18, 5)
  exitPrice    Decimal?        @db.Decimal(18, 5)
  profit       Decimal?        @db.Decimal(18, 2)
  status       OperationStatus @default(OPEN)
  expiresAt    DateTime
  openedAt     DateTime        @default(now())
  closedAt     DateTime?
  // Liquidity-cycle outcome decided at OPEN time for users with
  // liquidityMode=true. Persists across restarts so the worker always
  // honours the cycle plan even if the API crashed/redeployed between
  // open and resolve. Values: NULL (non-liquidity op), 'WIN', 'LOSS'.
  liquidityOutcome String?

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, status])
  @@index([expiresAt, status])
  @@map("operations")
}

model Transaction {
  id          String          @id @default(cuid())
  accountId   String
  type        TransactionType
  amount      Decimal         @db.Decimal(18, 2)
  description String?
  createdAt   DateTime        @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("transactions")
}

model KycSubmission {
  id                String     @id @default(cuid())
  userId            String     @unique  // one active submission per user
  documentFrontUrl  String
  documentBackUrl   String
  selfieUrl         String
  status            KycStatus  @default(SUBMITTED)  // SUBMITTED → APPROVED|REJECTED
  reason            String?    // populated when status = REJECTED
  submittedAt       DateTime   @default(now())
  reviewedAt        DateTime?
  reviewedBy        String?    // admin user id

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, submittedAt])
  @@map("kyc_submissions")
}

model Deposit {
  id          String         @id @default(cuid())
  accountId   String
  amount      Decimal        @db.Decimal(18, 2)  // valor em BRL (mesmo pra crypto, convertido)
  bonus       Decimal?       @db.Decimal(18, 2)  // promotional bonus credited on payment
  method      DepositMethod  @default(PIX)
  externalId  String?        // gateway transaction reference
  status      DepositStatus  @default(PENDING)
  isFake      Boolean        @default(false)     // admin marker: test/manual deposit
  notes       String?
  // ── Crypto-specific (USDT/BTC/etc via BSPay cashin) ──────────────────
  // Preenchidos quando method=CRYPTO. Null pra PIX.
  cryptoNetwork  String?   // "TRC20" | "ERC20" | "BEP20"
  cryptoCurrency String?   // "USDT" | "BTC" | etc
  cryptoAddress  String?   // endereco da carteira gerado pela BSPay (user envia pra ca')
  cryptoAmount   Decimal?  @db.Decimal(18, 8)  // valor em crypto (ex: 10.50 USDT)
  cryptoTxHash   String?   // hash da tx on-chain (preenchido pelo webhook)
  cryptoFromAddr String?   // endereco do payer (auditoria)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  paidAt      DateTime?

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([accountId, status])
  @@index([cryptoTxHash])  // pra lookup rapido no webhook
  @@map("deposits")
}

model Withdrawal {
  id          String           @id @default(cuid())
  accountId   String
  amount      Decimal          @db.Decimal(18, 2)
  method      WithdrawalMethod
  destination String           // PIX key, USDT wallet, bank account info
  status      WithdrawalStatus @default(PENDING)
  notes       String?          // Admin notes / failure reason
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  processedAt DateTime?        // Set when status moves out of PENDING

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, status])
  @@index([status, createdAt])
  @@map("withdrawals")
}

// Tradable instrument the admin can enable / disable and price (payout %).
// Source of truth lives here so admins can tune odds per asset without a
// code change. The trading frontend still uses a static catalog today —
// migration to consume this table is a follow-up.
model Asset {
  id            String        @id @default(cuid())
  symbol        String        @unique  // "EURUSD"
  name          String                 // "Euro / Dólar"
  category      AssetCategory
  payout        Int           @default(85)  // % — 1..100
  enabled       Boolean       @default(true)
  // Flag codes (flagcdn.com) for the leading/trailing currency. CRYPTO rows
  // may pass "crypto:btc" etc. to render a coin icon instead of a flag.
  code1         String?
  code2         String?
  // Optional Binance market symbol for live pricing on crypto / forex.
  // When null AND seedPrice is set, the asset is OTC-priced server-side.
  marketSymbol  String?
  // Manual sort key — admin can drag-reorder later; for now we seed in the
  // order we want them to display.
  displayOrder  Int           @default(0)

  // ── OTC pricing controls (used only when marketSymbol IS NULL) ─────────
  // seedPrice    = baseline the random walk mean-reverts toward. Without
  //                this set the OTC worker skips the asset entirely.
  // volatility   = tick size as a fraction of seedPrice (0.0005 ≈ 5 bp).
  // tickIntervalMs = how often the worker advances this asset. Default 1s;
  //                  bumping it (e.g. to 250ms) makes "fast" OTC assets.
  seedPrice       Decimal?      @db.Decimal(18, 5)
  volatility      Float         @default(0.0005)
  tickIntervalMs  Int           @default(1000)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([category, displayOrder])
  @@map("assets")
}

// Support ticket opened by a user. The first message body lives in TicketMessage
// (so all replies share one model); the ticket row itself only carries metadata
// (subject, status, priority). Admin actions: reply, change status, change priority.
model Ticket {
  id         String         @id @default(cuid())
  userId     String
  subject    String
  status     TicketStatus   @default(OPEN)
  priority   TicketPriority @default(MEDIUM)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  // Last activity timestamp — used for sorting in admin view. Bumped on any
  // new message OR status/priority change.
  lastActivityAt DateTime   @default(now())

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  TicketMessage[]

  @@index([status, lastActivityAt])
  @@index([userId, createdAt])
  @@map("tickets")
}

// One message in a ticket thread. authorId is the user OR the admin id.
// isAdmin distinguishes the two without an extra join (admins are still
// rows in `users`, just with role = ADMIN). The first message of a ticket
// is created together with the ticket itself (atomic in the create handler).
model TicketMessage {
  id            String   @id @default(cuid())
  ticketId      String
  authorId      String
  isAdmin       Boolean  @default(false)
  body          String
  // Optional image attachment, stored as a data URL (data:image/...;base64,...)
  // Same approach KYC uses — keeps us free of object storage infra for now.
  attachmentUrl String?
  createdAt     DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

// ─── OTC v2 — server-side pricing engine ──────────────────────────────────
// Brand new tables (otc_* prefix) kept fully isolated from the legacy
// `assets` + `asset_price_ticks` pair, which stays put until Etapa 8
// cleanup. Binance assets are untouched — they live in mockData.ts on the
// frontend and use Binance's own kline WebSocket. The new engine only
// drives the 5 OTC assets seeded in migration 20260524_otc_v2_seed.

model OtcAsset {
  id              String       @id              // 'eur-usd-otc'
  symbol          String       @unique          // 'EUR/USD'
  name            String                        // 'EUR/USD OTC'
  category        OtcCategory
  enabled         Boolean      @default(true)
  paused          Boolean      @default(false)  // admin can freeze the engine for this asset
  payout          Int          @default(85)
  // Baseline price the random walk mean-reverts toward.
  seedPrice       Decimal      @db.Decimal(18, 5)
  // Tick size as a fraction of seedPrice (e.g., 0.0005 = 5 basis points).
  volatilityBase  Float        @default(0.0005)
  // Multiplies the engine's tick rate. 1 = base (10Hz); 2 = "fast" asset.
  speedMultiplier Float        @default(1.0)
  displayOrder    Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  state               OtcMarketState?
  liquidity           OtcLiquidityState?
  snapshot            OtcEngineSnapshot?
  ticks               OtcTick[]
  candles             OtcCandle[]
  events              OtcScheduledEvent[]
  manipulationSignals OtcManipulationSignal[]

  @@index([category, displayOrder])
  @@map("otc_assets")
}

// Admin-scheduled forced candle outcome. Engine reads on every tick;
// when the current building candle's slot matches an active signal,
// nudges the price near slot end so the candle closes with the
// configured direction (CALL = up, PUT = down). Surgical — affects
// only the targeted slot, regime FSM continues normally before + after.
model OtcManipulationSignal {
  id          String   @id @default(cuid())
  assetId     String
  scheduledAt DateTime
  timeframe   Int      @default(60)
  direction   String   // 'CALL' | 'PUT' — DB CHECK constraint enforces
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  asset       OtcAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, scheduledAt(sort: Desc)])
  @@map("otc_manipulation_signals")
}

// Single-row settings table for the manipulation master kill switch.
// id is always 'global'; UI flips `enabled` without a redeploy.
model OtcManipulationSettings {
  id        String   @id @default("global")
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@map("otc_manipulation_settings")
}

// Append-only tick stream. Engine writes batched (~1s) to keep DB
// pressure low; retention ~1h via a periodic prune job.
model OtcTick {
  id          BigInt   @id @default(autoincrement())
  assetId     String
  price       Decimal  @db.Decimal(18, 5)
  recordedAt  DateTime @default(now()) @db.Timestamptz(3)

  asset       OtcAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, recordedAt(sort: Desc)])
  // Fase 7: covers the prune query `WHERE recordedAt < NOW() - INTERVAL '1h'`
  // which can't use the leading-assetId index. Added via migration
  // 20260525014500_otc_ticks_recordedat_index.
  @@index([recordedAt], name: "otc_ticks_recordedAt_idx")
  @@map("otc_ticks")
}

// Aggregated OHLC bars per (asset, timeframe). One row per slot.
// `finalizedAt` non-null = candle closed (timeframe rolled). Worker reads
// the candle covering `op.expiresAt` for resolution; never recomputes.
model OtcCandle {
  id           BigInt   @id @default(autoincrement())
  assetId      String
  timeframe    Int                                       // seconds: 5, 15, 30, 60, 300
  openTime     DateTime @db.Timestamptz(3)
  openPrice    Decimal  @db.Decimal(18, 5)
  highPrice    Decimal  @db.Decimal(18, 5)
  lowPrice     Decimal  @db.Decimal(18, 5)
  closePrice   Decimal  @db.Decimal(18, 5)
  tickCount    Int
  finalizedAt  DateTime? @db.Timestamptz(3)

  asset        OtcAsset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, timeframe, openTime])
  @@index([assetId, timeframe, openTime(sort: Desc)])
  // Fase 7: covers the prune query `WHERE timeframe = X AND openTime < Y`
  // which can't use the leading-assetId index efficiently.
  @@index([timeframe, openTime], name: "otc_candles_timeframe_openTime_idx")
  @@map("otc_candles")
}

// Per-asset market regime FSM state. One row per asset (assetId is PK).
model OtcMarketState {
  assetId          String     @id
  currentRegime    OtcRegime  @default(LATERAL)
  regimeStartedAt  DateTime   @default(now())
  regimeDurationS  Int        @default(60)
  // Effective drift applied per tick (signed). Modulated by regime + events.
  currentDrift     Float      @default(0)
  // Effective volatility per tick. Modulated by regime.
  currentVol       Float      @default(0.0005)
  // Admin override: long-running bias added to drift. -1..+1.
  trendBias        Float      @default(0)
  updatedAt        DateTime   @updatedAt

  asset            OtcAsset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  @@map("otc_market_state")
}

// Per-asset liquidity / order-book simulation. Slow-moving (~10s update
// cadence) compared to ticks.
model OtcLiquidityState {
  assetId       String   @id
  spread        Float    @default(0.0001)
  buyPressure   Float    @default(0.5)   // 0..1
  sellPressure  Float    @default(0.5)
  volume        Float    @default(1.0)   // 0.5..2.0 multiplier
  depth         Float    @default(1.0)
  speed         Float    @default(1.0)
  updatedAt     DateTime @updatedAt

  asset         OtcAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  @@map("otc_liquidity_state")
}

// Admin-scheduled events that bias the engine for a window.
model OtcScheduledEvent {
  id           String              @id @default(cuid())
  assetId      String
  startAt      DateTime
  durationSec  Int
  direction    OtcEventDirection
  strength     OtcEventStrength
  volatility   Float?                              // optional override during the event
  note         String?
  status       OtcEventStatus      @default(SCHEDULED)
  createdBy    String                              // admin userId
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  asset        OtcAsset            @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([status, startAt])
  @@index([assetId, status])
  @@map("otc_scheduled_events")
}

// Engine self-diagnostic log (errors, regime transitions, etc.).
model OtcEngineLog {
  id         BigInt   @id @default(autoincrement())
  level      String                                // 'INFO' | 'WARN' | 'ERROR'
  message    String
  context    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@map("otc_engine_logs")
}

// Deterministic engine snapshot (Fase 3). One row per asset, UPSERTed
// every 5s + on shutdown. Primary boot recovery source — captures the
// EMA-smoothed price + full FSM/liquidity state atomically so a
// restart resumes without the multi-source reconstruction that
// candle/tick fallbacks have to do.
model OtcEngineSnapshot {
  assetId          String   @id
  snapshotVersion  Int      @default(1)
  currentPrice     Decimal  @db.Decimal(18, 5)
  smoothedPrice    Decimal  @db.Decimal(18, 5)
  regime           OtcRegime
  regimeStartedAt  DateTime @db.Timestamptz(3)
  regimeDurationMs Int
  spread           Float    @default(0.0001)
  buyPressure      Float    @default(0.5)
  sellPressure     Float    @default(0.5)
  volume           Float    @default(1.0)
  depth            Float    @default(1.0)
  speed            Float    @default(1.0)
  trendBias        Float    @default(0)
  lastTickTime     DateTime? @db.Timestamptz(3)
  lastCandleTime   DateTime? @db.Timestamptz(3)
  // M1 streak tracking — persiste o cap "max 5 velas iguais" entre
  // restarts. Sem isso o counter zerava no boot e a regra podia falhar
  // se o engine reiniciasse no meio de um streak.
  m1DirectionStreak  Int       @default(0)
  m1LastDirection    String?   // 'UP' | 'DOWN'
  forceReverseUntilAt DateTime? @db.Timestamptz(3)   // quando o force-reverse expira
  forceReverseDir    String?   // 'UP' | 'DOWN' — direcao que estamos puxando AWAY FROM
  forceNextCandleDir String?   // 'UP' | 'DOWN' — hard-force da proxima vela M1
  updatedAt        DateTime  @default(now()) @db.Timestamptz(3)

  asset            OtcAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([updatedAt(sort: Desc)])
  @@map("otc_engine_snapshot")
}

// "Trust this device" pro step-up 2FA do admin. Apos validar o code,
// um token random (32 bytes hex) e' salvo aqui em HASH (sha256) e
// guardado num cookie httpOnly samesite=strict no client. Nas proximas
// visitas a /admin/login, o frontend tenta /auth/admin-step-up-trusted
// — se o cookie bate com um row valido aqui, pula o pedido do code.
//
// Token nunca volta a aparecer no app — apenas o hash e' persistido,
// igual ao bcrypt fluxo do password. revokedAt permite revogar
// individual sem precisar mexer no token (limpar todos = DELETE
// WHERE userId).
model AdminTrustedDevice {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  userAgent   String?
  ip          String?
  lastUsedAt  DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt   DateTime  @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt   DateTime? @db.Timestamptz(3)

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("admin_trusted_devices")
}

// ─── Bonus models (Fase B1) ───────────────────────────────────────────────

// Promotional code definition — created/edited by admin. One row per code.
model Bonus {
  id              String       @id @default(cuid())
  code            String       @unique          // e.g., 'BONUS200', case-insensitive in lookups
  type            BonusType
  // For PERCENTAGE: bonus amount = depositAmount × (value / 100)
  // For FIXED:      bonus amount = value (flat R$)
  value           Decimal      @db.Decimal(10, 2)
  // Minimum deposit (R$) required to redeem the code.
  minDeposit      Decimal      @db.Decimal(18, 2)
  // Multiplier: total operation volume the user needs to clear to unlock the
  // bonus. e.g., rollover=10 and bonusAmount=R$200 → user must operate R$2000.
  rollover        Int
  active          Boolean      @default(true)
  // Max successful redemptions per user account. Default 1 = one-shot codes.
  maxUsesPerUser  Int          @default(1)
  // Optional expiry — null = never expires.
  expiresAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  grants          BonusGrant[]

  @@map("bonuses")
}

// Per-user redemption instance. Tracks rollover progress until status
// transitions to COMPLETED, then withdrawals are unblocked.
model BonusGrant {
  id                String              @id @default(cuid())
  userId            String
  bonusId           String
  // Null only when admin granted manually (no underlying deposit).
  depositId         String?
  // Captured at grant time so admin edits to Bonus.value don't retroactively
  // change in-flight grants.
  bonusAmount       Decimal             @db.Decimal(18, 2)
  rolloverRequired  Decimal             @db.Decimal(18, 2)
  rolloverProgress  Decimal             @default(0) @db.Decimal(18, 2)
  status            BonusGrantStatus    @default(PENDING)
  grantedAt         DateTime            @default(now())
  completedAt       DateTime?
  cancelledAt       DateTime?

  bonus             Bonus               @relation(fields: [bonusId], references: [id], onDelete: Restrict)

  // Lookups by user (e.g., "do I have an active grant?") + by status (admin list).
  @@index([userId, status])
  @@index([status])
  // Constraint: at most ONE active (PENDING|ACTIVE) grant per user. Enforced
  // via a partial unique index in the accompanying migration since Prisma
  // doesn't have first-class partial unique support yet.
  @@map("bonus_grants")
}

// Audit trail of admin actions on OTC engine.
//
// Legacy. Mantido em paralelo ao AdminAuditLog enquanto o admin/otc/
// service ainda escreve aqui — consolidacao pra unica tabela fica pra
// quando todas as outras admin actions ja' estiverem usando o novo
// recordAdminAction (B1.5+).
model OtcAdminLog {
  id           BigInt   @id @default(autoincrement())
  adminId      String
  action       String                              // 'UPDATE_VOLATILITY', 'PAUSE_ASSET', ...
  assetId      String?
  beforeState  Json?
  afterState   Json?
  createdAt    DateTime @default(now())

  @@index([assetId, createdAt(sort: Desc)])
  @@index([adminId, createdAt(sort: Desc)])
  @@map("otc_admin_logs")
}

// Audit trail GENÉRICO de todas as admin actions (B1).
//
// Cobre TODO o painel admin — withdrawals approve/reject, users block/
// adjust, deposits mark-paid, kyc approve, settings update, etc. Antes
// dessa tabela so' o OTC tinha rastro (otc_admin_logs); o resto era
// "quem fez o quê" baseado em fé.
//
// Campos:
//   resourceType — categoria ampla: WITHDRAWAL, USER, DEPOSIT, KYC,
//                  ASSET, SETTINGS, EMAIL_TEMPLATE, BONUS_CODE,
//                  RANKING_PRIZE, OPERATION
//   resourceId   — id do recurso afetado (cuid/uuid/etc). Pode ser
//                  null pra acoes globais (ex: UPDATE_SETTINGS).
//   action       — verbo: APPROVE, REJECT, BLOCK, UNBLOCK, UPDATE,
//                  DELETE, ADJUST_BALANCE, TOGGLE_FAKE, CANCEL, etc.
//   before/after — snapshot serializado dos campos relevantes (uses
//                  bigintSafeReplacer pra sobreviver a counts bigint).
//   adminId      — User.id do admin que fez a acao
//   ip           — capturado de x-forwarded-for ou req.ip
//   userAgent    — header User-Agent (debug + deteccao de scripts)
//
// Indexes:
//   por createdAt (timeline reverso — admin abre painel e ve' o mais
//   recente primeiro)
//   por (resourceType, resourceId, createdAt) — historico de UM
//   recurso especifico (ex: "todas as acoes feitas neste usuario")
//   por (adminId, createdAt) — auditoria de UM admin especifico
model AdminAuditLog {
  id           BigInt   @id @default(autoincrement())
  resourceType String
  resourceId   String?
  action       String
  before       Json?
  after        Json?
  adminId      String
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([resourceType, resourceId, createdAt(sort: Desc)])
  @@index([adminId, createdAt(sort: Desc)])
  @@map("admin_audit_log")
}

// ── Platform settings ──────────────────────────────────────────────────
// Singleton (always one row with id='global') that holds the broker-wide
// limits + toggles editable from /admin/configuracoes. The API reads
// these on boot into a memory cache (settings/service.ts) and the cache
// is refreshed by the admin PATCH endpoint — so request-time validation
// is sync without paying a DB roundtrip per request.
model PlatformSettings {
  id                String   @id @default("global")

  // Withdrawals
  withdrawalFeePct  Decimal  @default(0)        @db.Decimal(5, 2)   // %
  withdrawalMin     Decimal  @default(60)       @db.Decimal(18, 2)
  withdrawalMax     Decimal  @default(10000)    @db.Decimal(18, 2)

  // Deposits
  depositMin        Decimal  @default(60)       @db.Decimal(18, 2)
  depositMax        Decimal  @default(100000)   @db.Decimal(18, 2)
  depositRollover   Decimal  @default(2)        @db.Decimal(6, 2)   // multiplier (no bonus)

  // Operations
  operationMin      Decimal  @default(5)        @db.Decimal(18, 2)
  operationMax      Decimal  @default(100000)   @db.Decimal(18, 2)
  operationMinIntervalMs Int @default(1000)                          // ms between consecutive trades

  // Auto-throttle: % de lucro sobre a banca (calculada do último depósito
  // confirmado) que dispara auto-ativação de Liquidez + bloqueio de
  // Cripto. Default 20 = quando saldo >= baseline * 1.20.
  autoLiquidityProfitPct Int  @default(20)
  // Gatilho ALTERNATIVO (OR): % do rollover atingido que também dispara
  // auto-Liquidez + bloqueio de Cripto, mesmo sem atingir o lucro acima.
  // Default 50 = quando rolloverProgress >= rolloverRequired * 0.50. 0 desativa.
  autoLiquidityRolloverPct Int @default(50)

  // Feature toggles
  copyTradeEnabled  Boolean  @default(true)
  // Modo Seguro (Anti-DevTools) — UX-level deterrent that the frontend's
  // <SafeMode /> component reacts to (blocks F12/right-click, closes the
  // tab on devtools detection, periodic console.clear). Off by default.
  safeModeEnabled   Boolean  @default(false)

  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())

  @@map("platform_settings")
}

// ── Ranking (fake leaderboard) ─────────────────────────────────────────
// Pool of fictitious users that the admin manages from /admin/ranking.
// The public /ranking endpoint picks 25 from this pool every 3 hours
// (deterministic shuffle keyed on the 3h window) and exposes them to
// the user-facing RankingPanel. Real user trade data is NEVER mixed in —
// this is purely a marketing/social-proof display.
model RankingEntry {
  id          String   @id @default(cuid())
  name        String                // 'João S.', 'Mariana X.', etc.
  countryCode String                // ISO 3166-1 alpha-2: 'br', 'us', 'jp', ...
  amount      Decimal  @db.Decimal(18, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
  @@map("ranking_entries")
}

// ── Email system ───────────────────────────────────────────────────────
// Admin-editable templates rendered with Handlebars-style {{var}}
// substitution. `key` is the stable identifier the backend looks up
// (e.g. WELCOME, PASSWORD_RESET); `name` is the friendly label shown
// in the admin panel. `active=false` short-circuits the send so admin
// can disable a category without losing the template body.
model EmailTemplate {
  key         String    @id              // 'WELCOME', 'PASSWORD_RESET', etc.
  name        String                     // 'Boas-vindas'
  description String                     // 'Enviado após cadastro concluído'
  subject     String                     // 'Bem-vindo à Vx Global!'
  htmlBody    String                     // full HTML, supports {{vars}}
  variables   String[]  @default([])     // ['name', 'cpf'] — for admin UI hints
  active      Boolean   @default(true)
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())

  @@map("email_templates")
}

// One-shot tokens for the forgot-password flow. Stored hashed (sha256)
// so a DB dump can't be replayed; expire after 1h and burn on use.
model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique             // sha256 of the raw token sent in the email
  expiresAt  DateTime
  usedAt     DateTime?                     // null = still valid; non-null = burned
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// Bot API refresh tokens — see apps/api/src/bot/
//
// Only the SHA-256 hash of the raw refresh token is persisted, so a DB
// leak doesn't compromise live sessions. Rotation on each /refresh call
// (mark old row revoked, insert new row) means a stolen-but-rotated
// token stops working as soon as the legitimate client refreshes.
model BotRefreshToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("bot_refresh_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// Meta Conversions API integration. Three tables — admin configures Pixel ID
// + token at /admin/meta-pixel (NOT via env vars), backend sends server-side
// events on user register + deposit confirmation. See apps/api/src/meta/.

model MetaPixelSettings {
  id            String   @id @default("global")
  enabled       Boolean  @default(false)
  pixelId       String?
  pixelToken    String?
  testEventCode String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@map("meta_pixel_settings")
}

model UserTracking {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fbp         String?
  fbc         String?
  fbclid      String?
  // click_id (param `sck` da URL do bot). Usado como external_id nos
  // postbacks pro TrackFlow — é o que casa o evento com o clique do anúncio.
  sck         String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@map("user_tracking")
}

// Histórico de IPs de acesso (login). 1 linha por (userId, ip) — o login faz
// upsert atômico (ON CONFLICT) que incrementa count + atualiza lastSeenAt e o
// userAgent mais recente. Mantém a tabela pequena (1 row por IP distinto) e é
// exatamente o que o painel admin exibe pra detectar conta compartilhada /
// multi-acesso. ip é NOT NULL ('unknown' quando o proxy não envia) por causa
// do unique composto.
model LoginHistory {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip          String
  userAgent   String?
  count       Int      @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([userId, ip])
  @@index([userId, lastSeenAt])
  @@map("login_history")
}

model MetaEventLog {
  id           String   @id @default(cuid())
  eventName    String
  eventId      String
  userId       String?
  depositId    String?
  payload      Json
  response     Json?
  success      Boolean  @default(false)
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([eventId])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("meta_events_log")
}

// ─────────────────────────────────────────────────────────────────────────────
// Outbound webhook configuration — per-event URL + on/off toggle.
//
// `key` is one of: REGISTRATION, FIRST_DEPOSIT, SUBSEQUENT_DEPOSIT (enforced
// at the service layer, not the DB, so new event types can ship without a
// migration). The fire-and-forget sender in apps/api/src/webhooks/ looks up
// the row, no-ops if `active` is false or `url` is empty, otherwise POSTs
// the event payload with retry + 30s timeout. Admin manages via /admin/webhooks.
model WebhookConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  url       String   @default("")
  active    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("webhook_configs")
}

// ─────────────────────────────────────────────────────────────────────────────
// COPY TRADING — módulo 100% isolado. NÃO se relaciona com operations,
// rollover, ranking, metas ou estatísticas (essas leem `operations`). As
// "operações copiadas" vivem em copy_trade_operations e são só display:
// não mexem em saldo, não viram ordem real, não contam rollover.
//
// Sem @relation com User/Account de propósito — guarda userId/accountId como
// String + FK no SQL. Mantém o módulo desacoplado dos models existentes.

// Catálogo de traders (admin edita os 8). Tudo que aparece no card vem daqui.
model CopyTrader {
  id            String   @id @default(cuid())
  name          String
  countryCode   String   @default("br")          // ISO alpha-2 p/ bandeira
  avatarUrl     String?                            // opcional
  vip           Boolean  @default(false)
  paid          Boolean  @default(false)           // tipo: false=Gratuito, true=Pago
  accessPrice   Decimal  @default(0) @db.Decimal(18, 2)  // valor_acesso (se pago)
  weeklyGainPct Decimal  @default(0) @db.Decimal(6, 2)   // ganho_semanal %
  copiers       Int      @default(0)               // copiadores (display)
  copiedTrades  Int      @default(0)               // operacoes_copiadas (display)
  commissionPct Int      @default(0)               // comissao %
  profitPct     Int      @default(0)               // lucro_percentual (barra verde)
  lossPct       Int      @default(0)               // perda_percentual (barra vermelha)
  active        Boolean  @default(true)
  displayOrder  Int      @default(0)
  // Crescimento "orgânico" diário: o copyWorker soma +5..7 em copiers e
  // copiedTrades a cada 24h (veracidade). lastGrowthAt = último incremento.
  lastGrowthAt  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([active, displayOrder])
  @@map("copy_traders")
}

// Assinatura do usuário a um trader (1 ativa por par user+trader).
model UserCopyTrader {
  id          String    @id @default(cuid())
  userId      String
  traderId    String
  activatedAt DateTime  @default(now())
  pricePaid   Decimal   @default(0) @db.Decimal(18, 2)  // 0 se gratuito
  status      String    @default("ACTIVE")              // ACTIVE | CANCELLED
  nextCycleAt DateTime?                                 // quando o copyWorker reinicia o ciclo (24h após o anterior)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, status])
  @@index([traderId])
  @@index([status, nextCycleAt])
  @@map("user_copy_traders")
}

// Operações copiadas. Geradas 3 LOSS + 2 WIN por ciclo de cópia (ordem
// aleatória). NÃO são instantâneas: cada uma tem um scheduledAt (1ª em 1min, demais
// a cada 30min) e fica PENDING até o copyWorker liquidar. Ao liquidar, MEXE no
// saldo REAL (WIN credita +amount, LOSS debita -amount) e lança COPY_RESULT no
// extrato. NÃO contam rollover/ranking (essas leem a tabela `operations`).
model CopyTradeOperation {
  id          String    @id @default(cuid())
  userId      String
  traderId    String
  result      String                                   // 'WIN' | 'LOSS'
  amount      Decimal   @default(0) @db.Decimal(18, 2) // valor da op = 10% da banca na cópia
  pnl         Decimal   @default(0) @db.Decimal(18, 2) // resultado aplicado no saldo (set no settle)
  isCopyTrade Boolean   @default(true) @map("is_copy_trade")
  status      String    @default("PENDING")            // PENDING | SETTLED | CANCELLED
  scheduledAt DateTime  @default(now())                // quando a op "aparece" e liquida
  settledAt   DateTime?                                // quando foi liquidada (set no settle)
  createdAt   DateTime  @default(now())

  @@index([userId, traderId])
  @@index([status, scheduledAt])
  @@map("copy_trade_operations")
}

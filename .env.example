# App
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/gw_broker?schema=public"

# Redis
REDIS_URL="redis://:password@localhost:6379"

# JWT
JWT_SECRET="troque_por_string_aleatoria_minimo_32_chars"
JWT_REFRESH_SECRET="troque_por_outra_string_aleatoria_32_chars"

# Twelve Data
TWELVE_DATA_API_KEY="sua_chave_aqui"

# BSPAY (PIX gateway)
# Get client_id + client_secret from your BSPay account dashboard.
BSPAY_CLIENT_ID="seu_client_id_bspay"
BSPAY_CLIENT_SECRET="seu_client_secret_bspay"
# Optional — defaults to production.
BSPAY_BASE_URL="https://api.bspay.co"
# Random string used as path-bearer secret on the webhook URL.
# Generate with:  openssl rand -hex 32
BSPAY_WEBHOOK_SECRET="generate_a_random_hex_string"
# Public URL of THIS API service — used to build the postback_url BSPay calls.
API_PUBLIC_URL="https://api.vx-global.com"

# n8n / Evolution API
N8N_WEBHOOK_URL="https://n8n.seusite.com/webhook/..."
EVOLUTION_API_KEY="..."
